#!/usr/bin/env bash
set -uo pipefail

# container
if [[ -z "${NESTOR_CONTAINER:-}" && -z "${NESTOR_IMAGE:-}" ]]; then
  echo "container: no"
else
  echo "container: ${NESTOR_CONTAINER:-?} - ${NESTOR_IMAGE:-?}"
fi

# workdir
branch=
if git rev-parse --is-inside-work-tree &>/dev/null; then
  branch=$(git branch --show-current)
  [[ -z $branch ]] && branch="detached@$(git rev-parse --short HEAD 2>/dev/null || echo '?')"
fi
echo "workdir: $PWD${branch:+ ($branch)}"

# repository (only shown when it differs from pwd)
if common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
  main=$(dirname "$common")
  if [[ $main != "$(pwd -P)" ]]; then
    echo "repository: $main"
  fi
fi

# auth-proxy
authProxyAddr=${NESTOR_AUTH_PROXY_ADDR:-}
if [[ -z $authProxyAddr ]]; then
  echo "auth-proxy: not set"
else
  hp=${authProxyAddr#*://}   # strip scheme
  hp=${hp%%/*}      # strip path
  host=${hp%:*}
  port=${hp##*:}
  if timeout 2 bash -c "exec 3<>/dev/tcp/$host/$port" 2>/dev/null; then
    echo "auth-proxy: $authProxyAddr (reachable)"
  else
    echo "auth-proxy: $authProxyAddr (unreachable)"
  fi
fi

# proxy
proxyAddr=${NESTOR_PROXY_ADDR:-}
if [[ -z $proxyAddr ]]; then
  echo "auth-proxy: not set"
else
  hp=${proxyAddr#*://}   # strip scheme
  hp=${hp%%/*}      # strip path
  host=${hp%:*}
  port=${hp##*:}
  if timeout 2 bash -c "exec 3<>/dev/tcp/$host/$port" 2>/dev/null; then
    echo "proxy: $proxyAddr (reachable)"
  else
    echo "proxy: $proxyAddr (unreachable)"
  fi
fi
